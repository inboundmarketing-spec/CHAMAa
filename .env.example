# Database
DATABASE_URL=postgresql://chama:chama_dev@localhost:5432/chama

# Redis
REDIS_URL=redis://localhost:6379

# API
PORT=3001
NODE_ENV=development
JWT_SECRET=change-me-in-production-min-32-chars
MESARIO_API_KEY=mesario-dev-key-change-me
PUBLIC_API_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# WhatsApp — escolha o provedor (protótipo → produção)
# ---------------------------------------------------------------------------
# dev       = simulador (demo ao chefe, sem WhatsApp real) — PADRÃO
# evolution = WhatsApp real via Evolution API + QR (grátis, protótipo)
# cloud     = API oficial Meta (produção, após contratação)
WHATSAPP_PROVIDER=dev

# --- Provedor: dev (nenhuma config extra) ---

# --- Provedor: evolution (protótipo com celular real) ---
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_INSTANCE=chama
EVOLUTION_API_KEY=

# --- Provedor: cloud (migração futura — Meta Business) ---
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=chama-webhook-verify-token

# Instagram Graph API
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_POLL_INTERVAL_MS=300000

# WhatsApp groups / moderation
MODERATION_GROUP_WA_ID=
BROADCAST_GROUP_WA_IDS=

# Next.js admin panel
NEXT_PUBLIC_API_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Chaminha (Ajuda) — LLM via OpenRouter (recomendado; use modelo :free)
# ---------------------------------------------------------------------------
HELP_LLM_ENABLED=false
# Chave em https://openrouter.ai/keys (formato sk-or-v1-...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
HELP_LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
HELP_LLM_MAX_TOKENS=500
HELP_LLM_TIMEOUT_MS=25000
OPENROUTER_SITE_URL=http://localhost:3001
OPENROUTER_APP_NAME=CHAMA Chaminha
